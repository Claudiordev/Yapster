{
  "realm": "voxsi",
  "displayName": "Voxsi",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Regular member" },
      { "name": "MODERATOR", "description": "Moderator" },
      { "name": "ADMIN", "description": "Administrator" },
      { "name": "PREMIUM", "description": "Premium member" },
      { "name": "PREMIUM_PLUS", "description": "Premium+ member" }
    ]
  },
  "defaultRole": { "name": "default-roles-voxsi", "composite": true },
  "clients": [
    {
      "clientId": "voxsi-web",
      "name": "Voxsi web (Next.js BFF)",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:3001/api/auth/callback", "http://localhost:3000/api/auth/callback"],
      "webOrigins": ["http://localhost:3001", "http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3001/*##http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
