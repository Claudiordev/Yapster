# Server-side only: how the Next server reaches the gateway (same host as Next).
# Browser calls hit /api on the Next origin, not this URL — so localhost is right.
API_BASE_URL=http://localhost:8080

# Chat WebSocket host for the browser. Leave UNSET so it derives from the page
# origin: open the app at localhost → ws://localhost:8080; open it at a LAN IP →
# ws://<that-IP>:8080. Set it only to force a specific host (e.g. a WS domain
# behind HTTPS in production).
# NEXT_PUBLIC_CHAT_WS_URL=ws://host:8080/ws

